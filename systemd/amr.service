[Unit]
Description=AI Memory Runtime (AMR) - Unified Semantic Memory & GPU Daemon
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/dj/WorkSpaces/ai-memory-runtime
Environment="PYTHONPATH=/home/dj/WorkSpaces/ai-memory-runtime"
Environment="CUDA_VISIBLE_DEVICES=0"
ExecStart=/usr/bin/python3 src/main.py
Restart=always
RestartSec=3s

# Sandboxing and security
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/run/user/1000 /home/dj/WorkSpaces/ai-memory-runtime/data
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
