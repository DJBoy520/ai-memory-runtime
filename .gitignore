# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Pytest & Coverage
.pytest_cache/
.coverage
htmlcov/

# Local configuration & secrets (绝不上库安全红线)
config/config.yaml
config/*.local.yaml
!config/config.example.yaml
.env*
*.aep
*.log

# Data & database
data/
*.db
*.db-wal
*.db-shm

# Sockets & runtimes
*.sock

# Virtual environments
venv/
.venv/
models/

# Local config backups
config/*.bak-*

# local migration reports (generated next to sqlite db)
migration_report.json

# Docker/Unraid 部署本地材料（2026-11-20 2.1.0）：证书与凭据绝不入库
secrets/
tls/
tls-unraid/
**/tls-unraid/
*.key
*.crt
*.csr
*.pem
*.srl
credentials*.json
remote*.json
*.sqlite*
