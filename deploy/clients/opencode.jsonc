// ~/.config/opencode/opencode.jsonc (excerpt).
// The native plugin `opencode-amr` uses the adapter and defaults to the
// per-agent token file. The MCP entry exposes the same adapter as tools.
{
  "plugin": ["opencode-amr"],
  "mcp": {
    "amr": {
      "type": "local",
      "command": [
        "/home/dj/WorkSpaces/ai-memory-runtime/.venv/bin/python",
        "/home/dj/WorkSpaces/ai-memory-runtime/src/interfaces/mcp/bridge.py"
      ],
      "environment": {
        "PYTHONPATH": "/home/dj/WorkSpaces/ai-memory-runtime",
        "AMR_SOURCE_AGENT": "opencode",
        "AMR_SOCKET_PATH": "/run/user/1000/amr2-opencode.sock",
        "AMR2_TOKEN_FILE": "/home/dj/.config/amr/agents/current/tokens/opencode.token"
      }
    }
  }
}
