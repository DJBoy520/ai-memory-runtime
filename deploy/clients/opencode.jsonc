// ~/.config/opencode/opencode.jsonc (excerpt)
// Prefer `opencode mcp add amr --url ... --header ...` so the schema is
// generated by the installed OpenCode version.
{
  "mcp": {
    "amr": {
      "type": "remote",
      "url": "https://amr.internal:8443/mcp",
      "headers": { "Authorization": "Bearer {env:AMR_TOKEN}" }
    }
  }
}
